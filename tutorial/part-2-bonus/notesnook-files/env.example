# Notesnook sync server settings — copy this file to ".env" and fill in the
# values marked CHANGE ME. Lines starting with # are comments.

# --- Things you must change -----------------------------------------------

# Where Notesnook keeps its data on the encrypted drive (no trailing slash).
# The default matches the Part 1 setup; change it only if your drive is elsewhere.
NOTESNOOK_DATA_DIR=/mnt/storage/notesnook

# Long random secret used to sign login tokens.
# CHANGE ME: generate with   openssl rand -hex 32
NOTESNOOK_API_SECRET=

# Login for the attachment storage (Silo). Only the server uses these.
# CHANGE ME: user >3 chars, password >8 chars. Generate with  openssl rand -hex 24
MINIO_ROOT_USER=notesnook
MINIO_ROOT_PASSWORD=

# Your Pi's full Tailscale name. CHANGE ME: replace  homeserver.tail1234ab.ts.net
# in ALL FOUR lines below with the name Tailscale gives your Pi
# (shown by:  tailscale status --json | grep DNSName). Keep the ports.
# Using your own domain instead (bonus 4)? Use https://<sub>.notes.example.com
# with no port, as described in that bonus.
NOTESNOOK_API_PUBLIC_URL=https://homeserver.tail1234ab.ts.net:5264
AUTH_SERVER_PUBLIC_URL=https://homeserver.tail1234ab.ts.net:8264
MONOGRAPH_PUBLIC_URL=https://homeserver.tail1234ab.ts.net:6264
ATTACHMENTS_SERVER_PUBLIC_URL=https://homeserver.tail1234ab.ts.net:9000

# --- Things you change once, later ------------------------------------------

# Leave false until you've created your account, then set to true and run
#   docker compose up -d
# so nobody else can sign up.
DISABLE_SIGNUPS=false

# --- Fine as they are ---------------------------------------------------------

# Name shown in the apps for your server.
INSTANCE_NAME=notesnook

# Notesnook server release to run. To update, change this, then
#   docker compose pull && docker compose up -d
NOTESNOOK_VERSION=v1.0-beta.52

# Used for links in emails; you won't have email set up, so leave it.
NOTESNOOK_APP_PUBLIC_URL=https://app.notesnook.com

# Empty = allow the official web app (app.notesnook.com) and all apps to connect.
NOTESNOOK_CORS_ORIGINS=
KNOWN_PROXIES=

# Email (optional). Without it, password-reset emails and email 2FA codes won't
# be sent — use an authenticator app for 2FA instead (the guide covers this).
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_HOST=
SMTP_PORT=

# SMS 2FA via Twilio (optional, leave blank).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=
